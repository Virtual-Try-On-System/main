# Copy this file to .env and fill in the values. Never commit .env.
# List every variable the project needs here, without real values.

# Cloud storage for checkpoints, used by rclone. This example is for S3.
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_REGION=
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
